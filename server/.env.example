# TiDB Cloud Serverless (primary) — from tidbcloud.com cluster "Connect" panel
TIDB_HOST=gateway01.xx-xxxxx.prod.aws.tidbcloud.com
TIDB_PORT=4000
TIDB_USER=xxxxxxxx.root
TIDB_PASSWORD=
TIDB_DATABASE=Shivdutt_Biography

# Local MySQL (secondary) — isolated instance set up on this machine
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=Shivdutt_Biography

# Port the API server itself listens on (separate from TiDB's port 4000 above)
PORT=5000

# Origin allowed to call the API with credentials (the site's dev/hosting URL)
SITE_ORIGIN=http://localhost:3000

# Admin login for the site customizer
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=
